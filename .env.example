# Operating mode for the portal's api proxy layer.
#   offline (default) — serve bundled fixtures from fixtures/
#   online            — proxy to the upstream economic-data-api at API_BASE_URL
API_MODE=offline

# Used only when API_MODE=online. Points at the upstream FastAPI service.
API_BASE_URL=http://localhost:8000

# Optional logging configuration
# LOG_LEVEL=info        # trace, debug, info, warn, error, fatal
# LOG_FORMAT=json       # json or pretty (auto-detected from TTY when unset)
